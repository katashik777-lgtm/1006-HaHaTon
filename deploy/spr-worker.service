[Unit]
Description=SPR durable analytics worker
After=network.target

[Service]
User=spr
Group=spr
WorkingDirectory=/opt/spr
EnvironmentFile=/etc/spr.env
Environment=PYTHONUTF8=1
ExecStart=/opt/spr/.venv/bin/python -m spr.worker
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/spr
TimeoutStopSec=45
KillMode=control-group

[Install]
WantedBy=multi-user.target
